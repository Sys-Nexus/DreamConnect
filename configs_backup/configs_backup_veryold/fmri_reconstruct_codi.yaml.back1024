# See more details in LICENSE.

model:
  base_learning_rate: 1.0e-05
  weight_decay: 0.01
  target: ldm.models.diffusion.fmri_ddpm_reconstruct.LatentDiffusion
  params:
    fp16: True
    deepspeed: 'deepspeed_1'
    ## codi bacbone not support fps16
    # fp16: False
    # deepspeed: 'deepspeedfp32_1'
    # deepspeed: ''
    # ckpt_path: stable_diffusion/models/ldm/stable-diffusion-v1/v1-5-pruned-emaonly-adaption.ckpt
    ckpt_path: stable_diffusion/models/ldm/stable-diffusion-v1/v1-5-pruned-emaonly-adaption-task-humanalign.ckpt
    linear_start: 0.00085
    linear_end: 0.0120
    num_timesteps_cond: 1
    log_every_t: 200
    timesteps: 1000
    first_stage_key: edited
    cond_stage_key: fmri_edit
    fmri_cond_stage_key: fmri_edit
    image_size: 32
    channels: 4
    cond_stage_trainable: false   # Note: different from the one we trained before
    cond_stage_trainable_fmri: false   # Note: different from the one we trained before
    unet_stage_trainable: true  # Note: different from the one we trained before
    # unet_stage_trainable: false  # Note: different from the one we trained before
    # conditioning_key: hybrid
    # conditioning_key: fmri_hybrid
    conditioning_key: fmri_reconstruct
    monitor: val/loss_simple_ema
    scale_factor: 0.18215
    unet_lr_ratio: 1e-9
    scheduler_config: # 10000 warmup steps
      target: ldm.lr_scheduler.LambdaLinearScheduler
      params:
        warm_up_steps: [ 0 ]
        cycle_lengths: [ 10000000000000 ] # incredibly large number to prevent corner cases
        f_start: [ 1.e-6 ]
        f_max: [ 1. ]
        f_min: [ 1. ]

    pretrained_unet_path: /data/yashengsun/Proj/MMEdit/CoDI/checkpoints/CoDi_video_diffuser_8frames.pth
    unet_config:
      target: CoDI.core.models.latent_diffusion.diffusion_unet.UNetModel2D
      params: 
        input_channels: 4
        model_channels: 320
        output_channels: 4
        num_noattn_blocks: [ 2, 2, 2, 2 ]
        channel_mult: [ 1, 2, 4, 4 ]
        with_attn: [true, true, true, false]
        num_heads: 8
        context_dim: 768
        use_checkpoint: True
        use_video_architecture: True
        init_connector: False
        force_type_convert: True
        use_fp16: True
        # force_type_convert: False

    first_stage_config:
      target: ldm.models.autoencoder.AutoencoderKL
      params:
        embed_dim: 4
        monitor: val/rec_loss
        ddconfig:
          double_z: true
          z_channels: 4
          resolution: 256
          in_channels: 3
          out_ch: 3
          ch: 128
          ch_mult:
          - 1
          - 2
          - 4
          - 4
          num_res_blocks: 2
          attn_resolutions: []
          dropout: 0.0
        lossconfig:
          target: torch.nn.Identity

    cond_stage_config:
      target: ldm.modules.encoders.modules.FrozenCLIPEmbedder
      # target: third_party.CoDI.core.models.encoders.clip.FrozenCLIP
      # params: 
      #   ckpt_path: '/data/yashengsun/Proj/MMEdit/CoDI/checkpoints/CoDi_encoders.pth'

    cond_stage_config_fmri:
      target: ldm.modules.encoders.fmri.FmriEmbedder
      params:
        force_type_convert: true
        is_infer: true

    # cond_stage_config_fmri:
    #   target: CoDI.core.models.encoders.fmri.FmriEmbedder
    #   params:
    #     force_type_convert: True
    #     # force_type_convert: False
    #     # adaptor_fmri2image_path: 'logs/fmri_instruct_encoder_context_fmri_instruct_encoder_context_2023-10-03/checkpoints/ckpt_epoch_500/mp_rank_00_model_states.pt'
    #     # adaptor_fmri2image_path: 'logs/fmri_instruct_encoder_context_fmri_instruct_encoder_context_2023-10-05/checkpoints/ckpt_epoch_500/mp_rank_00_model_states.pt'
    #     adaptor_fmri2image_path: '/data/yashengsun/Proj/lavis/output/BLIP2/Pretrain/20230901210/checkpoint_50.pth'

data:
  target: main.DataModuleFromConfig
  params:
    batch_size: 2
    num_workers: 4
    train:
      target: third_party.StableDiffusionReconstruction.codes.utils.nsd_creater.NIPS23NSDDataset
      params:
        nsd_root: '/data/yashengsun/Proj/MMEdit/StableDiffusionReconstruction/nsd'
        resolution: 320
        split: 'train'
        is_reconstruct_mode: True
        url: 'nsd_data_dir/train_subj01_{0..17}.tar'

    validation:
      target: third_party.StableDiffusionReconstruction.codes.utils.nsd_creater.NIPS23NSDDataset
      params:
        nsd_root: '/data/yashengsun/Proj/MMEdit/StableDiffusionReconstruction/nsd'
        resolution: 320
        split: 'train'
        is_reconstruct_mode: True
        url: 'nsd_data_dir/test_subj01_{0..1}.tar'

trainer:
  initial_scale: 13
  max_epochs: 200
  save_freq: 5
  accumulate_grad_batches: 1
  clip_grad: 0.0
  optimizer: adamw